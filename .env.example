# Copy to `.env` for local dev. Never commit the real .env.

# ── Database ─────────────────────────────────────────────────────────────
# Local dev: a SQLite file (nothing to install).
# Production: a Postgres connection string; the app switches adapters on the
# `postgres://` prefix automatically.
DATABASE_URI=file:./agency.db

# ── Payload secret ───────────────────────────────────────────────────────
# Signs login tokens. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# ── Public site URL ──────────────────────────────────────────────────────
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Media storage (production only) ──────────────────────────────────────
# An S3-compatible bucket — Cloudflare R2 by default, but any S3-compatible
# service works (just change S3_ENDPOINT). When S3_BUCKET is unset, uploads
# save to the local `media/` folder instead, so local dev needs none of this.
#
# Cloudflare R2: dash.cloudflare.com → R2 → create a bucket, then
# R2 → Manage API Tokens → create a token with Object Read & Write.
# S3_ENDPOINT is https://<account-id>.r2.cloudflarestorage.com
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Seed login (local) ───────────────────────────────────────────────────
# Password for the admin user `npm run seed` creates. Change it in /admin.
SEED_ADMIN_PASSWORD=
